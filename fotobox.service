[Unit]
Description=Fotobox
# NetworkManager.service steht mit dabei, weil network.target nur sagt, dass
# die Netzwerk-Einrichtung begonnen hat — nicht, dass NM laeuft und wlan0
# kennt. Ohne die Ordnung gewann beim Kaltstart manchmal die Fotobox das
# Rennen und der Hotspot fiel aus. Bewusst KEIN network-online.target:
# NetworkManager-wait-online wartet auf eine aktivierte Verbindung, und die
# gibt es hier per Definition erst, wenn wir selbst den AP aufspannen — das
# Target liefe in seinen Timeout und verzoegerte jeden Boot.
After=graphical.target network.target NetworkManager.service
Wants=graphical.target
# Bremse gegen schnelle Absturz-Schleifen: 5 Fehlstarts in 5 Minuten, dann
# bleibt der Service stehen. Sie greift gegen einen Prozess, der sofort wieder
# stirbt (5 s RestartSec => 5 Starts in 25 s), nicht mehr gegen "kein
# Display": darauf wartet die UI seit UI.DISPLAY_WAIT_S bis zu 90 s im
# Prozess, ein Durchlauf dauert damit ~95 s und in kein 300-s-Fenster passen
# 5 davon. Genau so gewollt — kommt die Desktop-Sitzung spaeter doch noch,
# faengt die Box sich von selbst, statt bis zum naechsten SSH-Login
# schwarz zu bleiben.
# Gehoert seit systemd 229 in [Unit], nicht in [Service].
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
ExecStart=__PYTHON__ __INSTALL_DIR__/main.py
# Ein Absturz mitten im Event darf die Box nicht bis zum naechsten SSH-Login
# tot liegen lassen. StartLimit* verhindert die Endlosschleife, wenn der
# Fehler dauerhaft ist (z.B. kein Display) — dann bleibt sie nach 5 Versuchen
# in 5 Minuten stehen, statt die Logs vollzuschreiben.
#
# "always" und nicht "on-failure": main.py endet auch dann mit 0, wenn die
# Display-Session wegbricht — fuer systemd sieht das aus wie ein geordnetes
# Ende, und mit on-failure blieb die Box danach tot liegen. Am 26.08. zweimal
# passiert, einmal ueber Nacht: neun Stunden Ausfall, ohne eine einzige
# Fehlerzeile im Log.
#
# Ein "systemctl stop" loest trotz "always" keinen Neustart aus — einen
# angeordneten Stop respektiert systemd.
Restart=always
RestartSec=5
# Die einzige Ausnahme: Esc am Boxbildschirm (main.EXIT_USER_QUIT). Wer dort
# bewusst beendet, will die Box aus haben und nicht funf Sekunden spaeter
# wieder anlaufen sehen.
RestartPreventExitStatus=42
User=__USER__
Group=__USER__
Environment=DISPLAY=:0
Environment=XAUTHORITY=__HOME__/.Xauthority
WorkingDirectory=__INSTALL_DIR__
# /run/fotobox wird von systemd bei jedem Start angelegt (und dem Service-User
# uebergeben). Vorher ueberlebte das Verzeichnis den Reboot nicht und kam nur
# zurueck, weil usb_export.py es als root neu anlegt.
RuntimeDirectory=fotobox
RuntimeDirectoryMode=0755
# Nicht beim Service-Stop loeschen: der USB-Export laeuft per udev auch dann,
# wenn die Fotobox gerade nicht laeuft, und schreibt seinen Status dorthin.
RuntimeDirectoryPreserve=yes
StandardOutput=append:__INSTALL_DIR__/logs/fotobox.log
StandardError=append:__INSTALL_DIR__/logs/fotobox.log
KillSignal=SIGTERM
# Eine laufende Aufnahme (gphoto2 --capture-image-and-download) kann bis zu
# 30 s dauern. Bei Stop/Neustart/Reboot mitten im Foto muss systemd so lange
# warten, sonst wird gphoto2 hart gekillt und die Kamera haengt am USB (kommt
# oft nur per Aus/An zurueck). 35 s = Capture-Timeout (30 s) + Reserve.
TimeoutStopSec=35

[Install]
WantedBy=graphical.target
