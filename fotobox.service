[Unit]
Description=Fotobox
After=graphical.target network.target
Wants=graphical.target

[Service]
ExecStart=/usr/bin/python3 /home/pi/fotobox/main.py
Restart=always
RestartSec=5
User=pi
Group=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
WorkingDirectory=/home/pi/fotobox
StandardOutput=append:/home/pi/fotobox/logs/fotobox.log
StandardError=append:/home/pi/fotobox/logs/fotobox.log
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=graphical.target
